// Solution of leetcode question 424. Longest Repeating Character Replacement
// Using sliding window

class Solution {
public:
    int characterReplacement(string s, int k) {

        int low = 0;
        int res = 0;

        unordered_map<char,int> f;

        int maxfreq = 0;
        

        for(int high = 0; high < s.size(); high++)
        {
            f[s[high]]++;

            maxfreq = max(maxfreq, f[s[high]]);

            while((high - low + 1) - maxfreq > k)
            {
                f[s[low]]--;
                low++;
            }

            int len = high - low + 1;

            res = max(res, len);
        }

        return res;
    }
};
